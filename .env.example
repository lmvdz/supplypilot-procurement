# Server-only. Never prefix credentials with NEXT_PUBLIC_. Keep values out of source control.
# Default deployed experience is the simulator. No external credentials are present.
PAYPAL_MODE=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional OpenRouter: server-only and synthetic demo fixtures only.
# A key alone does not activate AI. No provider is configured in this source.
AI_MODE=demo
OPENROUTER_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Free primary model verified in the OpenRouter catalog on Oct 5, 2026.
AI_PRIMARY_MODEL=liquid/lfm-2.5-2.6b:free
AI_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# Explicit paid opt-in is required. Never enable silently.
AI_ALLOW_PAID_FALLBACK=false
# USD per million tokens; provider-dependent price ceilings, not a spending budget.
AI_FALLBACK_MAX_PROMPT_PRICE=0.02
AI_FALLBACK_MAX_COMPLETION_PRICE=0.50

# Private hosted app access. Generate at least 32 random URL-safe characters.
SITE_OWNER_KEY=
